      "expected_abstention_phrases": ["not specified", "not provided", "not disclosed"],
      "expected_intent": "abstain_missing_evidence",
      "required_elements": ["not specified"],
      "critical": true,
      "evaluated_metrics": ["deterministic_faithfulness", "abstention_quality", "entity_id_grounding", "response_relevance"],
      "expected_failure_conditions": ["fabricates any numerical compensation"]
