{
  "version": "1.0",
  "description": "Synthetic deterministic semantic evaluation dataset for CollarCheck Phase 2 Step 3B.",
  "cases": [
    {
      "case_id": "SEM-01",
      "category": "straightforward_salary_query",
      "query": "What is the salary for the Python lead?",
      "synthetic_evidence": "Job 101: Senior Python Lead at AlphaTech in Delhi. Fixed compensation is 35 LPA. Work mode: Hybrid.",
      "expected_entity_id": "job_101",
      "supported_facts": ["35 LPA", "Python Lead"],
      "forbidden_claims": ["45 LPA", "Not specified"],
      "requires_abstention": false,
      "abstention_type": null,
      "expected_abstention_phrases": [],
      "expected_intent": "provide_salary",
      "required_elements": ["35 LPA"],
      "evaluated_metrics": ["deterministic_faithfulness", "entity_id_grounding", "response_relevance"],
      "expected_failure_conditions": ["mentions 45 LPA", "fails to state 35 LPA"]
    },
    {
      "case_id": "SEM-02",
