# Example environment configuration. Copy this file to .env and fill in your keys.
GROQ_API_KEY=your_groq_api_key_here

# Langfuse Observability (Opt-in; disabled by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=1.0.0
LANGFUSE_SAMPLE_RATE=1.0
# Optional dedicated HMAC secret for cross-request session correlation (omit to exclude session IDs entirely)
LANGFUSE_SESSION_HMAC_SECRET=

# Company Claim Status Strict Mode (Opt-in; set to true to disable legacy is_verified fallback)
STRICT_CLAIM_STATUS_ENABLED=false

# Database Socket Timeouts (seconds; positive integers or decimals/floats supported by PyMySQL, e.g. 5.0, 0.5)
DB_CONNECT_TIMEOUT_SECONDS=5.0
DB_READ_TIMEOUT_SECONDS=10.0
DB_WRITE_TIMEOUT_SECONDS=10.0

# Redis Session & Conversation History Store (Strict RAM-only)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
SESSION_TTL_SECONDS=1800
MAX_SESSION_MESSAGES=100
MAX_SESSION_BYTES=524288
MAX_MESSAGE_CHARS=8000

